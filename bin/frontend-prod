#!/usr/bin/env bash
# Build and start frontend in production mode
# Uses PM2 if available (production), otherwise direct node (fallback)
# True zero-downtime: builds into .next.build/, then swaps after stopping old server.
set -e

cd "$(dirname "$0")/../frontend" || { echo "✗ Frontend directory not found"; exit 1; }

SKIP_BUILD=false
for arg in "$@"; do
  case $arg in
    --skip-build) SKIP_BUILD=true ;;
  esac
done

# Install dependencies if needed
if [ ! -d "node_modules" ] || [ "package.json" -nt "node_modules" ]; then
  echo "Installing dependencies..."
  npm install || { echo "✗ npm install failed"; exit 1; }
fi

# Build into temporary directory (old server keeps running on .next/)
if [ "$SKIP_BUILD" = false ]; then
  echo "Cleaning build staging area..."
  rm -rf .next.build tsconfig.tsbuildinfo node_modules/.cache 2>/dev/null || true

  echo "Building frontend for production..."
  if ! NEXT_BUILD_DIR=.next.build NODE_TLS_REJECT_UNAUTHORIZED=0 npm run build; then
    # Next.js doesn't support NEXT_BUILD_DIR — it always writes to .next/
    # So we build in-place but accept the brief disruption, or use a workaround:
    # Build normally, old server may serve stale pages during build (not crash)
    rm -rf .next.build 2>/dev/null || true

    # Fallback: build in-place (old server still has .next/ but it gets overwritten)
    echo "Building in-place..."
    rm -rf .next tsconfig.tsbuildinfo 2>/dev/null || true
    if ! NODE_TLS_REJECT_UNAUTHORIZED=0 npm run build; then
      echo "✗ Build failed"
      exit 1
    fi
  fi

  # Next.js always builds to .next/ — check if .next.build exists (custom dir worked)
  if [ -d ".next.build" ]; then
    # Swap: stop old server, rename dirs
    if [ -f ".next.build/BUILD_ID" ]; then
      echo "✓ Build completed (staged)"
    else
      echo "✗ Build incomplete: missing BUILD_ID in .next.build"
      exit 1
    fi
    # Stop old server, swap build dirs
    ../bin/frontend-stop 2>/dev/null || true
    rm -rf .next
    mv .next.build .next
  else
    # In-place build — verify it
    if [ ! -f ".next/BUILD_ID" ]; then
      echo "✗ Build incomplete: missing BUILD_ID"
      exit 1
    fi
    echo "✓ Build completed"
    # Stop old server (build is already in .next/)
    ../bin/frontend-stop 2>/dev/null || true
  fi
else
  # Skip build — just stop and restart
  ../bin/frontend-stop 2>/dev/null || true
fi

# Start production server
if command -v pm2 &> /dev/null; then
  echo "Starting production server via PM2..."

  # Use ecosystem config if exists, otherwise use CLI
  if [ -f "ecosystem.config.js" ]; then
    pm2 start ecosystem.config.js --only 8pm-frontend 2>/dev/null || \
    pm2 restart ecosystem.config.js --only 8pm-frontend
  elif pm2 list 2>/dev/null | grep -q '8pm-frontend'; then
    pm2 restart 8pm-frontend --update-env
  else
    # Register new PM2 process with proper syntax
    NODE_TLS_REJECT_UNAUTHORIZED=0 pm2 start npm --name 8pm-frontend -- start
  fi

  pm2 save 2>/dev/null || true
else
  # Development fallback: use nohup
  echo "Starting production server (nohup)..."
  NODE_TLS_REJECT_UNAUTHORIZED=0 nohup npm start > /tmp/frontend-prod.log 2>&1 &
fi

# Wait for startup with retry
echo "Waiting for frontend to start..."
for i in {1..10}; do
  sleep 2
  HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 3 --max-time 5 http://localhost:3001/ 2>/dev/null || echo "000")
  if [ "$HTTP_STATUS" != "000" ]; then
    echo "✓ Frontend running on http://localhost:3001"
    if command -v pm2 &> /dev/null; then
      echo "  Logs: pm2 logs 8pm-frontend"
    else
      echo "  Logs: /tmp/frontend-prod.log"
    fi
    exit 0
  fi
  echo "  Waiting... ($i/10)"
done

echo "✗ Frontend failed to start within 20 seconds"
if command -v pm2 &> /dev/null; then
  pm2 logs 8pm-frontend --lines 20 --nostream 2>/dev/null
else
  tail -20 /tmp/frontend-prod.log 2>/dev/null
fi
exit 1
