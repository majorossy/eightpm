#!/usr/bin/env bash
# Stop all 8PM production services (frontend + Docker)
set -e

echo "=== 8PM Production Shutdown ==="
echo ""

# Step 1: Stop frontend (don't let failure prevent Docker shutdown)
echo "Step 1/2: Stopping frontend..."
bin/frontend-stop || echo "⚠ Frontend stop had issues, continuing with Docker shutdown..."

# Step 2: Stop Docker containers
echo ""
echo "Step 2/2: Stopping Docker containers..."
bin/docker-compose --no-dev down --remove-orphans

echo ""
echo "✓ All services stopped"
