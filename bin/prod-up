#!/usr/bin/env bash
# Master script to start 8PM in production mode
# Handles everything: pre-flight check, Docker, GraphQL, frontend
set -e

# Parse args
PURGE=false
while [[ $# -gt 0 ]]; do
  case $1 in
    --purge) PURGE=true; shift ;;
    *) shift ;;
  esac
done

echo "=== 8PM Production Startup ==="
echo ""

# Handle purge mode
if [ "$PURGE" = true ]; then
  echo "Purge mode: clearing caches and forcing rebuild..."
  echo ""

  # Stop everything first (frontend + Docker)
  echo "  Stopping frontend..."
  bin/frontend-stop 2>/dev/null || true
  echo "  Stopping Docker containers..."
  bin/docker-compose --no-dev stop 2>/dev/null || true

  # Clear Redis cache
  echo "  Clearing Redis cache..."
  bin/docker-compose --no-dev exec -T redis redis-cli FLUSHALL 2>/dev/null || true

  # Clear frontend build
  echo "  Clearing frontend build cache..."
  rm -rf frontend/.next frontend/node_modules/.cache

  # Clear Magento generated files and static assets
  echo "  Clearing Magento generated files..."
  bin/docker-compose --no-dev exec -T phpfpm rm -rf /var/www/html/generated/* 2>/dev/null || true
  bin/docker-compose --no-dev exec -T phpfpm rm -rf /var/www/html/var/cache/* 2>/dev/null || true
  bin/docker-compose --no-dev exec -T phpfpm rm -rf /var/www/html/var/view_preprocessed/* 2>/dev/null || true
  bin/docker-compose --no-dev exec -T phpfpm rm -rf /var/www/html/pub/static/_cache/* 2>/dev/null || true

  echo ""
  echo "Caches cleared. Starting fresh..."
  echo ""
else
  # Pre-flight check: is site already running? (skip in purge mode)
  echo "Checking if site is already running..."
  if bin/verify-site --prod 2>/dev/null; then
    echo ""
    echo "✓ Site is already running! No action needed."
    exit 0
  fi
fi

echo ""
echo "Site not fully operational. Starting services..."
echo ""

# Step 0: Ensure Docker daemon is running
if ! docker info > /dev/null 2>&1; then
  echo "Docker not running, starting..."
  bin/docker-start
fi

# Step 1: Start Docker
echo "Step 1/4: Starting Docker containers..."
bin/start --no-dev

# Step 2: Wait for containers
echo ""
echo "Step 2/4: Waiting for containers to be healthy..."
bin/wait-containers --no-dev --timeout=90

# Step 2.5: Recompile DI after purge cleared generated/
if [ "$PURGE" = true ]; then
  echo ""
  echo "  Running setup:upgrade..."
  bin/magento setup:upgrade
  echo "  Recompiling DI..."
  bin/magento setup:di:compile
  echo "  Deploying static content..."
  bin/magento setup:static-content:deploy -f
  bin/magento cache:flush
fi

# Step 3: Wait for GraphQL
echo ""
echo "Step 3/4: Waiting for GraphQL API..."
bin/wait-graphql --timeout=120

# Step 4: Start frontend
echo ""
echo "Step 4/4: Starting frontend..."
if [ -f frontend/.next/BUILD_ID ] && [ ! "$PURGE" = true ]; then
  echo "  Using existing build..."
  bin/frontend-prod --skip-build
else
  echo "  Building frontend (this takes ~3 minutes)..."
  bin/frontend-prod
fi

# Final verification
echo ""
echo "=== Final Verification ==="
bin/verify-site --prod

echo ""
echo "✓ Production startup complete!"
